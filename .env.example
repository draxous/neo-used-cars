# Free access key from https://web3forms.com — enter your email and they send it to you.
# Copy this file to .env and paste your key below, then restart `npm run dev`.
VITE_WEB3FORMS_ACCESS_KEY=

# Supabase — https://supabase.com → your project → Settings → API.
# The anon key is safe to ship in the bundle; the service_role key is NOT — never put it here.
# In the Supabase dashboard, turn on Authentication → Providers → Email → "Confirm email",
# and add your site URL plus /verify-email and /reset-password under Authentication → URL Configuration.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
